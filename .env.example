HOST_PORT=8081
PORT=80

# Where the blog's subscribe form POSTs. Any provider that accepts a plain form
# post with an `email` field works — Buttondown, ConvertKit and Substack all do.
# Mailchimp names the field `EMAIL`, so it needs the input renamed to match.
#
#   NEWSLETTER_ENDPOINT=https://buttondown.com/api/emails/embed-subscribe/yourname
#
# Unset, the subscribe box renders disabled with a note pointing at the contact
# address, so the section is never a field that silently goes nowhere.
#
# Read at BUILD time, not at run time. The homepage is prerendered, so this is
# baked into the HTML by `npm run build` — which the Dockerfile runs inside the
# image build. Setting it in docker-compose's `environment:` is too late; pass it
# as `--build-arg NEWSLETTER_ENDPOINT=...`. Not a secret in any case: a form
# action is public the moment the page is served.
NEWSLETTER_ENDPOINT=
