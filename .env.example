HOST_PORT=8081
PORT=80

# ── Resend ───────────────────────────────────────────────────────────────────
# Both forms — the contact form and the blog subscribe box — post to server
# actions in lib/actions.js, which run per request. So unlike the build-time
# variable this replaced, everything below is ordinary RUNTIME configuration:
# set it in docker-compose's `environment:` and restart. No rebuild, no build arg.
#
# Missing any of it is a handled state, not a crash: the form answers with a
# message pointing at the contact address instead.

# https://resend.com/api-keys — the only actual secret here.
RESEND_API_KEY=

# Where blog subscribers are stored. Resend renamed Audiences to Segments, and
# the SDK deprecated `audienceId` in favour of `segments`; lib/actions.js accepts
# either, so set whichever your dashboard has and leave the other blank.
RESEND_SEGMENT_ID=
RESEND_AUDIENCE_ID=

# Sender address. Left blank this falls back to Resend's shared onboarding@resend.dev,
# which needs no domain verification but will ONLY deliver to the address the
# Resend account itself belongs to. That is fine here — the contact form mails you.
# Set it to something at a verified domain (e.g. hello@nemanjas.dev) once the
# domain is added in Resend.
RESEND_FROM=

# Where contact messages land. Blank falls back to contact.email in content/en.js.
CONTACT_TO=
